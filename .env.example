# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. Secrets here are for LOCAL MVP testing only —
# production must use a real secret manager (e.g. AWS Secrets Manager / GCP Secret Manager).

# --- Anthropic ---
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5
# Extractions below this confidence (0..1) are visually flagged in Telegram for manual verification.
EXTRACTION_CONFIDENCE_THRESHOLD=0.75

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# The admin's chat/user id that receives approval requests and reports.
# Tip: message @userinfobot on Telegram to get your numeric chat id.
TELEGRAM_CHAT_ID=

# --- Email intake (IMAP) ---
# A DEDICATED mailbox we control. The client auto-forwards Work Order emails here; `--poll` pulls
# new messages into data/incoming_emails/ and feeds them into the ingest pipeline.
# Use an APP PASSWORD (Gmail: Account > Security > App passwords; M365: app password / mailbox login),
# NOT the main account password.
IMAP_HOST=                 # e.g. imap.gmail.com  |  outlook.office365.com
IMAP_PORT=993              # 993 = IMAP over SSL
IMAP_USERNAME=             # usually the full email address of the dedicated mailbox
IMAP_PASSWORD=             # the app password
IMAP_MAILBOX=INBOX         # folder/label to read
# Optional server-side filters — leave blank to take every unseen message.
IMAP_FROM_FILTER=          # only fetch mail FROM this address/substring, e.g. @sktc.sg
IMAP_SUBJECT_FILTER=       # only fetch mail whose subject contains this, e.g. Work Order
IMAP_MARK_SEEN=true        # mark fetched mail as read so it isn't pulled again

# --- SKTC folder intake (Power Automate -> synced folder; alternative to IMAP above) ---
# Use this while IMAP Basic Auth is blocked on the mailbox's tenant. See
# docs/power_automate_sktc_setup.md for how to build the Power Automate flow itself.
SKTC_INTAKE_MODE=imap                        # "folder" | "imap"
SKTC_INTAKE_FOLDER=                          # TODO(human): local OneDrive/SharePoint-synced path
SKTC_INTAKE_PROCESSED_SUBFOLDER=processed    # subfolder that consumed PDFs+sidecars move into
SKTC_INTAKE_SIDECAR_WAIT_SECONDS=30          # how long to wait for a PDF's sidecar before treating it as orphaned
SKTC_SENDER_ALLOWLIST=                       # comma-separated sender addresses/substrings, e.g. jenny.ang@sktc.sg

# --- Batch report ---
# After each --batch run, a summary of every WO outcome is sent so the team can spot-check and fix in
# Synergix. Defaults to telegram (uses TELEGRAM_BOT_TOKEN/CHAT_ID above). To email the report instead
# (or in addition), set REPORT_CHANNEL=email or =both and add the SMTP_*/REPORT_FROM/REPORT_TO vars —
# see src/report.py for the full list; omitted here since email reporting isn't in use.
REPORT_CHANNEL=telegram

# --- JBTC TCMS portal (Dynamics 365 based, web, no API) ---
TCMS_BASE_URL=
TCMS_USERNAME=
TCMS_PASSWORD=

# --- Synergix ERP (web, no API) ---
SYNERGIX_BASE_URL=
SYNERGIX_USERNAME=
SYNERGIX_PASSWORD=
# Which WO field to search Synergix on for the "already invoiced?" check: wo_po | job_sheet.
# JBTC's un-invoiced list is hand-maintained and can be stale, so this check prevents double billing.
SYNERGIX_DEDUP_KEY=wo_po
# Synergix's Cloudflare is GEO-based (blocks overseas IPs), not headless detection — headless works
# fine from a Singapore IP. Set false only if a future protection change challenges headless.
SYNERGIX_HEADLESS=true
# Session guardrails for long batches (Synergix session times out and stalls mid-run):
# start a fresh Synergix session every N WOs (0 = off), and cap each WO's wall-clock (seconds).
SYNERGIX_RELOGIN_EVERY=5
SYNERGIX_WO_TIMEOUT_S=900
# Synergix gets slower/flakier the longer one browser process stays open under sustained use,
# separate from the login-session timeout SYNERGIX_RELOGIN_EVERY guards against. Every N WOs,
# close the browser entirely and launch a fresh one instead of just re-navigating (0 = off).
SYNERGIX_FRESH_BROWSER_EVERY=40

# --- Behaviour ---
# MUST stay true until live testing is explicitly approved. In DRY_RUN the Synergix
# driver performs every step EXCEPT the final submit/confirm click (which is logged).
DRY_RUN=true
# DEV ONLY: when Synergix isn't configured, the dedup check can't verify invoiced status and returns
# UNCERTAIN (fail-safe) so WOs land in NEEDS_REVIEW. Set true to instead assume NOT_DUPLICATE so the
# approval flow can be demoed locally. NEVER true with real billing.
DEDUP_STUB_ASSUME_SAFE=false
# false during dev so you can watch the browser; set true for headless runs later.
HEADLESS=false
TIMEZONE=Asia/Singapore
